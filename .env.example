# 環境変数設定ファイル
# このファイルを .env にコピーして使用してください

# プロジェクトルートディレクトリ（自動検出される場合は設定不要）
# PROJECT_ROOT=/path/to/invest-monitoring-db

# データベースファイルへの相対パス（プロジェクトルートからの相対パス）
DATABASE_PATH=data/invest.db

# 更新スクリプトへの相対パス（プロジェクトルートからの相対パス）
UPDATE_SCRIPT_PATH=scripts/update_indicators.py

# バックフィルスクリプトへの相対パス（プロジェクトルートからの相対パス）
BACKFILL_SCRIPT_PATH=scripts/backfill_data.py

# バックフィル期間（年数）
BACKFILL_YEARS=5
