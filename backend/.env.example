DATABASE_URL=postgresql://invest:invest@localhost:5432/invest
LEGACY_SQLITE_PATH=data/invest.db
# Cloud Runなどの公開APIではtrueにし、PostgreSQLとHTTP APIの書き込みを無効化する
DATABASE_READ_ONLY=false
BACKFILL_YEARS=5
CORS_ORIGINS=["http://localhost:3000"]
JQUANTS_API_KEY=
# 日次更新でJ-Quantsを使うか。プランの提供期間を確認した上で有効にする
JQUANTS_DAILY_ENABLED=false
JQUANTS_BASE_URL=https://api.jquants.com/v2
JQUANTS_TIMEOUT_SECONDS=30
# プランのレート制限（回/分）。Free=5 / Light=60 / Standard=120 / Premium=500
JQUANTS_REQUESTS_PER_MINUTE=5
RAW_DATA_PATH=data/raw
RAW_DATA_URI=
MANAGEMENT_API_ENABLED=false
MANAGEMENT_API_KEY=
